@model List<Store.Web.Models.HistoryOperationViewModel>

@{
    ViewData["Title"] = "History";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>History</h2>
    </div>

    @if (Model.Count > 0)
    {
        @foreach (var group in Model)
        {
            <section class="mb-5">
                <h5 class="mb-3 text-capitalize">
                    @group.Date.ToString("MMMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))
                </h5>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Total Amount</th>
                                <th>Amount Received</th>
                                <th>Change Returned</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var operation in group.Operations)
                            {
                                <tr>
                                    <td>@operation.TotalAmount.ToString("C")</td>
                                    <td>@operation.ReceivedAmount.ToString("C")</td>
                                    <td class="fw-semibold">
                                        @operation.ChangeAmount.ToString("C")
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Payment" asp-action="Details" asp-route-id="@operation.Id" class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
    else
    {
        <div class="text-center py-5">
            <h5>No operations found</h5>
            <p class="text-muted mb-3">
                You have not registered any operations yet.
            </p>
        </div>
    }
</div>
