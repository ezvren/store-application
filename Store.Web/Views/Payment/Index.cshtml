@model Store.Web.Models.PaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="d-flex align-items-center justify-content-center">
    <div class="w-50">

        @if(ViewBag.Message != null)
        {
            <div class="alert alert-warning" role="alert">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Payment" asp-action="PaymentOperation" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="TotalAmount" class="form-label"></label>
                <input asp-for="TotalAmount" value="@Model.TotalAmount" type="number" min="0" step="0.01" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ReceivedAmount" class="form-label"></label>
                <input asp-for="ReceivedAmount" value="@Model.ReceivedAmount" type="number" min="0" step="0.01" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Calculate Change
            </button>
        </form>
    </div>
</div>