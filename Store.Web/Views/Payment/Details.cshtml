@using Store.Core.Enum
@model Store.Web.Models.OperationViewModel

@{
    ViewData["Title"] = "Operation Details";
}
<div class="row">
    <div class="col-md-6">
        <h5 class="mt-4 mb-3">Operation Details</h5>

        <div class="table-responsive">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Total Amount</th>
                        <td class="text-end">
                            @Model.TotalAmount.ToString("C")
                        </td>
                    </tr>
                    <tr>
                        <th>Amount Received</th>
                        <td class="text-end">
                            @Model.ReceivedAmount.ToString("C")
                        </td>
                    </tr>
                    <tr>
                        <th>Change Returned</th>
                        <td class="text-end fw-bold">
                            @Model.ChangeAmount.ToString("C")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-6">
        <h5 class="mt-4 mb-3">Change Breakdown</h5>

        @if (Model.ChangeBreakdown.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Denomination</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ChangeBreakdown)
                        {
                            <tr>
                                <td>@(item.DenominationKind == DenominationKind.Bill ? "Bill" : "Coin")</td>
                                <td>@item.DenominationValue.ToString("C")</td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@((item.DenominationValue * item.Quantity).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">
                No change is required for this operation.
            </p>
        }
    </div>
</div>

<div class="d-flex justify-content-between mt-4">
    <button type="button" onclick="history.back()" class="btn btn-outline-secondary">
        Back
    </button>

    <a asp-controller="Payment" asp-action="Index" class="btn btn-primary">
        New Payment
    </a>
</div>